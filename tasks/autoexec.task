
# autoexec.task
#=========================================================================
# This TASK is being ran when BUDOSTACK starts.
# If you want to release your own application or game, modify the marked
# section below according to instructions.
#=========================================================================

#-------------------------------------------------------------------------
# INITIALIZATION

# Required to clear all screen buffer
RUN cls

# If ./apps/terminal is not running, skip the whole autoexec.task
SET $TMP = 0
RUN _TERM_ACTIVE TO $TMP
IF ($TMP==0):
  GOTO EXIT
END

# Disable mouse for the UI
RUN _TERM_MOUSE_SHOW disable

# Initialize variables

SET $LOAD = 0
SET $TYPING_SOUND = "disable"
SET $BACKGROUND_SOUND = "enable"
SET $BACKGROUND_VOLUME = 25
SET $SHADER = "disable"
SET $SHADER_QUALITY = "MEDIUM"
SET $OVERLAY = "null"
SET $LAYOUT_ASPECT = "screen"
SET $OVERLAY_ZOOM = 100
SET $OVERLAY_IMAGE_OFFSET_X = 0
SET $OVERLAY_IMAGE_OFFSET_Y = 0
SET $TERMINAL_WIDTH = 0
SET $TERMINAL_HEIGHT = 0
SET $TERMINAL_OFFSET_X = 0
SET $TERMINAL_OFFSET_Y = 0
SET $RESOLUTION = "null"
SET $TERM_SIZE = "81.5104167 74.0740741"
SET $MOUSE = "null"
SET $LOGIN_SCREEN = "null"
SET $LOGIN_MENU = "null"
SET $RETROPROFILE = "vt220-green"

# Run configurations from config.ini

RUN _CONFIG -read _TERM_TYPING_SOUND TO $TYPING_SOUND
RUN _TERM_TYPING_SOUND $TYPING_SOUND
RUN _CONFIG -read _TERM_TYPING_VOLUME TO $TYPING_VOLUME
RUN _TERM_TYPING_VOLUME $TYPING_VOLUME
RUN _CONFIG -read _TERM_BACKGROUND_SOUND TO $BACKGROUND_SOUND
RUN _TERM_BACKGROUND_SOUND $BACKGROUND_SOUND
RUN _CONFIG -read _TERM_BACKGROUND_VOLUME TO $BACKGROUND_VOLUME
RUN _TERM_BACKGROUND_VOLUME $BACKGROUND_VOLUME
RUN _CONFIG -read _TERM_SHADER TO $SHADER
RUN _TERM_SHADER $SHADER
RUN _CONFIG -read _TERM_OVERLAY TO $OVERLAY
RUN _CONFIG -read _TERM_LAYOUT_ASPECT TO $LAYOUT_ASPECT
RUN _TERM_LAYOUT_ASPECT $LAYOUT_ASPECT
RUN _CONFIG -read _TERM_OVERLAY_ZOOM TO $OVERLAY_ZOOM
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_X TO $OVERLAY_IMAGE_OFFSET_X
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_Y TO $OVERLAY_IMAGE_OFFSET_Y
RUN _TERM_OVERLAY_ZOOM $OVERLAY_ZOOM
RUN _TERM_OVERLAY_OFFSET $OVERLAY_IMAGE_OFFSET_X $OVERLAY_IMAGE_OFFSET_Y
RUN _CONFIG -read TERMINAL_WIDTH TO $TERMINAL_WIDTH
RUN _CONFIG -read TERMINAL_HEIGHT TO $TERMINAL_HEIGHT
RUN _CONFIG -read TERMINAL_OFFSET_X TO $TERMINAL_OFFSET_X
RUN _CONFIG -read TERMINAL_OFFSET_Y TO $TERMINAL_OFFSET_Y
IF ($OVERLAY == "enable"):
  RUN _TERM_OVERLAY enable
  RUN _TERM_SIZE $TERMINAL_WIDTH $TERMINAL_HEIGHT
  RUN _TERM_OFFSET $TERMINAL_OFFSET_X $TERMINAL_OFFSET_Y
END
IF ($OVERLAY == "disable"):
  RUN _TERM_OVERLAY disable
  RUN _TERM_SIZE 0 0
  RUN _TERM_OFFSET 0 0
END


# Run or set other default configurations

RUN _TERM_RESOLUTION HIGH
RUN _RETROPROFILE apply $RETROPROFILE
RUN _TERM_MARGIN 0

#-------------------------------------------------------------------------
# BUDOSTACK LOADER

SET $SELECTION = "y"
RUN cls
RUN _WAIT 200
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
PRINT "\nLOADING FIRMWARE"
SET $DOTS = 21
SET $DELAY = 150
FOR ($i=0; $i<$DOTS; $i=$i+1):
  IF ($i==10):
    RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
  END
  PRINT "."
  RUN _WAIT $DELAY
END
PRINT "OK!\n\n"
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
PRINT "\nSTARTING SYSTEM:\n"
PRINT "---------------------------------------\n\n"
RUN _WAIT 1000
#---------------------------------------
PRINT " BOOTSTRAP SEQUENCE ........... "
RUN _WAIT 1000
PRINT "PASS\n\n"
RUN _WAIT 100
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
#---------------------------------------
PRINT " MEMORY CHECK ................. "
RUN _WAIT 800
PRINT "PASS\n\n"
RUN _WAIT 10
#---------------------------------------
PRINT " KERNEL LOAD .................. "
RUN _WAIT 250
PRINT "COMPLETE\n\n"
RUN _WAIT 25
#---------------------------------------
PRINT " SYS/COMMS/UPLINK ............. "
RUN _WAIT 370
PRINT "ACTIVATED\n\n"
RUN _WAIT 10
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
#---------------------------------------
PRINT " LOADING BUDOSTACK DATABASE ... "
RUN _WAIT 400
PRINT "COMPLETE\n\n"
RUN _WAIT 70
#---------------------------------------
PRINT " MU/TH/UR CORE ................ "
RUN _WAIT 500
PRINT "READY\n\n"
RUN _WAIT 100
#---------------------------------------
PRINT " PRIMARY TERMINAL ............. "
RUN _WAIT 250
PRINT "ACTIVATED\n\n"
RUN _WAIT 90
PRINT "---------------------------------------\n\n"
PRINT "\nSYSTEM STARTED!\n\n\n"
RUN _TERM_SOUND_PLAY 2 ../sounds/environment/computer_beep.wav 100
PRINT "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n>> ENTER MENU? [y/n]: "
INPUT $SELECTION

IF ($SELECTION != "y"):
  GOTO EXIT
END

# Disable cursor blinking
RUN _TERM_CURSOR_BLINK disable

#-------------------------------------------------------------------------
# BUDOSTACK LOGIN SCREEN
@LOGIN_SCREEN

# Login screen behavior according to config.ini
RUN _CONFIG -read LOGIN_SCREEN TO $LOGIN_SCREEN

IF ($LOGIN_SCREEN == "disable"):
  GOTO LAUNCHER
END

RUN _CLEAR

# Following INTRO will run only in ./apps/terminal

RUN _TERM_ACTIVE TO $TERM_ACTIVE
IF ($TERM_ACTIVE == "1"):

  # Display "simulated" loading screen and play related sound effects

  RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
  @LOADING
  RUN _BAR -x 27 -y 29 -title LOADING: -progress $LOAD
  IF ($LOAD == 50):
    RUN _TERM_SOUND_PLAY 2 ../sounds/628246__asiekierka__floppy_access6.ogg 100
  END
  IF ($LOAD < 100):
    SET $LOAD = $LOAD + 10
    RUN _WAIT 250
    GOTO LOADING
  END

  # Display intro logo and play starting tune

  RUN _CLEAR
  RUN _WAIT 50
  SET $SPRITES = {}
  RUN _TERM_SPRITE_LOAD -file "./examples/assets/login_logo.png" TO $SPRITES[0]
  RUN _TERM_SPRITE -x 200 -y 120 -sprite $SPRITES[0] -layer 15
  RUN _TERM_RENDER -layer 15
  RUN _TERM_SOUND_PLAY 1 ../sounds/static_orchard.mp3 90
  RUN _WAIT 8300
  RUN _TEXT -x 28 -y 47 -text "- BUDOSTACK CORPORATION -" -color 1
  RUN _WAIT 4700
  RUN _TERM_CLEAN -x 0 -y 0 -width 640 -height 480 -layer 15
  RUN _TERM_RENDER -layer 15
  RUN _RECT -x 0 -y 0 -width 80 -height 60 -color 0 -fill on

END

#-------------------------------------------------------------------------
# BUDOSTACK LAUNCHER
@LAUNCHER

# Clear frame buffer
RUN cls

# Login menu behavior according to config.ini
RUN _CONFIG -read LOGIN_MENU TO $LOGIN_MENU

IF ($LOGIN_MENU == "disable"):
  GOTO EXIT
END


# VARIABLES

SET $MENU = "USER LOGIN"
SET $MENU_X = 32
SET $EVENT = 0
SET $CURSOR_X = $MENU_X-2
SET $CURSOR_Y = 28


# FUNCTIONS

FUNCTION DRAW_FRAME():
  RUN _CLEAR
  RUN _RECT -x 1 -y 1 -width 78 -height 58 -fill off
  RUN _TEXT -x 23 -y 3 -text "====== BUDOSTACK CORPORATION ====="
  RUN _TEXT -x 56 -y 57 -text " Ville Suoranta @ 2026 " -color 1
  RUN _TEXT -x 31 -y 55 -text "<ENTER> to SELECT"
END

FUNCTION DRAW_CURSOR($X, $Y):

  RUN _TEXT -x $X -y $Y -text ">"

END


# LAUNCHER APPLICATION

@LAUNCHER_MENU

RUN _CONFIG -read _TERM_OVERLAY TO $OVERLAY
RUN _CONFIG -read _TERM_LAYOUT_ASPECT TO $LAYOUT_ASPECT
RUN _TERM_LAYOUT_ASPECT $LAYOUT_ASPECT
RUN _CONFIG -read _TERM_OVERLAY_ZOOM TO $OVERLAY_ZOOM
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_X TO $OVERLAY_IMAGE_OFFSET_X
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_Y TO $OVERLAY_IMAGE_OFFSET_Y
RUN _TERM_OVERLAY_ZOOM $OVERLAY_ZOOM
RUN _TERM_OVERLAY_OFFSET $OVERLAY_IMAGE_OFFSET_X $OVERLAY_IMAGE_OFFSET_Y
IF ($OVERLAY == "enable"):
  RUN _TERM_OVERLAY enable
  RUN _TERM_SIZE $TERMINAL_WIDTH $TERMINAL_HEIGHT
  RUN _TERM_OFFSET $TERMINAL_OFFSET_X $TERMINAL_OFFSET_Y
END
IF ($OVERLAY == "disable"):
  RUN _TERM_OVERLAY disable
  RUN _TERM_SIZE 0 0
  RUN _TERM_OFFSET 0 0
END


EVAL DRAW_FRAME()


# USER LOGIN

IF ($MENU == "USER LOGIN"):

  # Work in progress
  $MENU = "QUICK START"

END


# MAIN MENU

IF ($MENU == "QUICK START"):

  # Limit cursor movement upon returning

  IF ($CURSOR_Y > 30):
    $CURSOR_Y = 30
  END


  # Draw

  RUN _TEXT -x $MENU_X-6 -y 24 -text "-- SELECT PRIME DIRECTIVE --             "
  RUN _TEXT -x $MENU_X+2 -y 28 -text "SYSTEM CONFIG      "
  RUN _TEXT -x $MENU_X+2 -y 30 -text "TERMINAL           "

  EVAL DRAW_CURSOR($CURSOR_X+2, $CURSOR_Y)


  # Process Input

  RUN _KEYS TO $EVENT

  IF ($EVENT == 2):
    # Up Arrow
    $CURSOR_Y = $CURSOR_Y - 2
  END

  IF ($EVENT == -2):
    # Down Arrow
    $CURSOR_Y = $CURSOR_Y + 2
  END

  IF ($EVENT == 10):
    # ESC Key
    GOTO EXIT
  END


  # Limit Cursor Movement

  IF ($CURSOR_Y < 28):
    $CURSOR_Y = 28
  END

  IF ($CURSOR_Y > 30):
    $CURSOR_Y = 30
  END


  # Act on ENTER press

  IF ($EVENT == 3):

    IF ($CURSOR_Y == 28):
      # Configuration Menu
      $MENU = "CONFIGURATION"
    END

    IF ($CURSOR_Y == 30):
      # Command line
      GOTO EXIT
    END

  END

END


# CONFIGURATION MENU

IF ($MENU == "CONFIGURATION"):

  # Fetch Configuration
  RUN _CONFIG -read _TERM_RESOLUTION TO $RESOLUTION
  RUN _CONFIG -read _TERM_MOUSE_SHOW TO $MOUSE
  RUN _CONFIG -read LOGIN_SCREEN TO $LOGIN_SCREEN
  RUN _CONFIG -read LOGIN_MENU TO $LOGIN_MENU
  RUN _CONFIG -read _RETROPROFILE TO $RETROPROFILE
  RUN _CONFIG -read _TERM_TYPING_SOUND TO $TYPING_SOUND
  RUN _CONFIG -read _TERM_TYPING_VOLUME TO $TYPING_VOLUME
  RUN _CONFIG -read _TERM_BACKGROUND_SOUND TO $BACKGROUND_SOUND
  RUN _CONFIG -read _TERM_BACKGROUND_VOLUME TO $BACKGROUND_VOLUME
  RUN _CONFIG -read _TERM_SHADER TO $SHADER
  RUN _CONFIG -read SHADER_QUALITY TO $SHADER_QUALITY
  RUN _CONFIG -read _TERM_OVERLAY TO $OVERLAY

  # Index retroprofile
  SET $RETROPROFILE_IDX = 0
  IF ($RETROPROFILE == "c64"):
    $RETROPROFILE_IDX = 0
  END
  IF ($RETROPROFILE == "ibm5150"):
    $RETROPROFILE_IDX = 1
  END
  IF ($RETROPROFILE == "vt220-amber"):
    $RETROPROFILE_IDX = 2
  END
  IF ($RETROPROFILE == "vt220-green"):
    $RETROPROFILE_IDX = 3
  END

  # Index shader quality
  SET $SHADER_QUALITY_IDX = 1
  IF ($SHADER_QUALITY == "LOW"):
    $SHADER_QUALITY_IDX = 0
  END
  IF ($SHADER_QUALITY == "MEDIUM"):
    $SHADER_QUALITY_IDX = 1
  END
  IF ($SHADER_QUALITY == "HIGH"):
    $SHADER_QUALITY_IDX = 2
  END

  # Introduce global y-offset for the menu
  SET $YOFF = 4

  # Draw

  RUN _TEXT -x $MENU_X-8 -y 18-$YOFF -text "For more settings see config.ini"
  RUN _TEXT -x $MENU_X-1 -y 22-$YOFF -text "-- CONFIGURATION --       "
  RUN _TEXT -x $MENU_X-3 -y 24-$YOFF -text "Resolution Mode = " + $RESOLUTION
  RUN _TEXT -x $MENU_X-3 -y 26-$YOFF -text "Mouse Cursor    = " + $MOUSE
  RUN _TEXT -x $MENU_X-3 -y 28-$YOFF -text "Login Screen    = " + $LOGIN_SCREEN
  RUN _TEXT -x $MENU_X-3 -y 30-$YOFF -text "Login Menu      = " + $LOGIN_MENU
  RUN _TEXT -x $MENU_X-3 -y 32-$YOFF -text "Typing Sound    = " + $TYPING_SOUND
  RUN _TEXT -x $MENU_X-3 -y 34-$YOFF -text "Typing Volume   = " + $TYPING_VOLUME
  RUN _TEXT -x $MENU_X-3 -y 36-$YOFF -text "Background Hum  = " + $BACKGROUND_SOUND
  RUN _TEXT -x $MENU_X-3 -y 38-$YOFF -text "Hum Volume      = " + $BACKGROUND_VOLUME
  RUN _TEXT -x $MENU_X-3 -y 40-$YOFF -text "Retro Profile   = " + $RETROPROFILE
  RUN _TEXT -x $MENU_X-3 -y 42-$YOFF -text "Shader Passes   = " + $SHADER
  RUN _TEXT -x $MENU_X-3 -y 44-$YOFF -text "Shaders         = " + $SHADER_QUALITY
  RUN _TEXT -x $MENU_X-3 -y 46-$YOFF -text "Overlay         = " + $OVERLAY
  RUN _TEXT -x $MENU_X-3 -y 48-$YOFF -text "<-- MAIN MENU             "

  EVAL DRAW_CURSOR($CURSOR_X-3, $CURSOR_Y)


  # Process Input

  RUN _KEYS TO $EVENT

  IF ($EVENT == 2):
    # Up Arrow
    $CURSOR_Y = $CURSOR_Y - 2
  END

  IF ($EVENT == -2):
    # Down Arrow
    $CURSOR_Y = $CURSOR_Y + 2
  END

  IF ($EVENT == 10):
    # ESC Key
    GOTO EXIT
  END


  # Limit Cursor Movement

  IF ($CURSOR_Y < 24-$YOFF):
    $CURSOR_Y = 24-$YOFF
  END
  IF ($CURSOR_Y > 48-$YOFF):
    $CURSOR_Y = 48-$YOFF
  END


  # Act on ENTER press

  IF ($EVENT == 3):
    # Enter Key

    IF ($CURSOR_Y == 24-$YOFF):
      # Set resolution
      IF ($RESOLUTION == "HIGH"):
        RUN _CONFIG -write _TERM_RESOLUTION LOW
      END
      IF ($RESOLUTION == "LOW"):
        RUN _CONFIG -write _TERM_RESOLUTION HIGH
      END
    END
    IF ($CURSOR_Y == 26-$YOFF):
      # Set mouse cursor
      IF ($MOUSE == "enable"):
        RUN _CONFIG -write _TERM_MOUSE_SHOW disable
      END
      IF ($MOUSE == "disable"):
        RUN _CONFIG -write _TERM_MOUSE_SHOW enable
      END
    END
    IF ($CURSOR_Y == 28-$YOFF):
      # Set login screen
      IF ($LOGIN_SCREEN == "enable"):
        RUN _CONFIG -write LOGIN_SCREEN disable
      END
      IF ($LOGIN_SCREEN == "disable"):
        RUN _CONFIG -write LOGIN_SCREEN enable
      END
    END
    IF ($CURSOR_Y == 30-$YOFF):
      # Set login menu
      IF ($LOGIN_MENU == "enable"):
        RUN _CONFIG -write LOGIN_MENU disable
      END
      IF ($LOGIN_MENU == "disable"):
        RUN _CONFIG -write LOGIN_MENU enable
      END
    END
    IF ($CURSOR_Y == 32-$YOFF):
      # Set typing sound
      IF ($TYPING_SOUND == "enable"):
        RUN _CONFIG -write _TERM_TYPING_SOUND disable
      END
      IF ($TYPING_SOUND == "disable"):
        RUN _CONFIG -write _TERM_TYPING_SOUND enable
      END
    END
    IF ($CURSOR_Y == 34-$YOFF):
      # Set typing volume
      IF ($TYPING_VOLUME == "0"):
        RUN _CONFIG -write _TERM_TYPING_VOLUME 25
      END
      IF ($TYPING_VOLUME == "25"):
        RUN _CONFIG -write _TERM_TYPING_VOLUME 50
      END
      IF ($TYPING_VOLUME == "50"):
        RUN _CONFIG -write _TERM_TYPING_VOLUME 75
      END
      IF ($TYPING_VOLUME == "75"):
        RUN _CONFIG -write _TERM_TYPING_VOLUME 100
      END
      IF ($TYPING_VOLUME == "100"):
        RUN _CONFIG -write _TERM_TYPING_VOLUME 0
      END
    END
    IF ($CURSOR_Y == 36-$YOFF):
      # Set background hum
      IF ($BACKGROUND_SOUND == "enable"):
        RUN _CONFIG -write _TERM_BACKGROUND_SOUND disable
      END
      IF ($BACKGROUND_SOUND == "disable"):
        RUN _CONFIG -write _TERM_BACKGROUND_SOUND enable
      END
    END
    IF ($CURSOR_Y == 38-$YOFF):
      # Set background hum volume
      IF ($BACKGROUND_VOLUME == "0"):
        RUN _CONFIG -write _TERM_BACKGROUND_VOLUME 25
      END
      IF ($BACKGROUND_VOLUME == "25"):
        RUN _CONFIG -write _TERM_BACKGROUND_VOLUME 50
      END
      IF ($BACKGROUND_VOLUME == "50"):
        RUN _CONFIG -write _TERM_BACKGROUND_VOLUME 75
      END
      IF ($BACKGROUND_VOLUME == "75"):
        RUN _CONFIG -write _TERM_BACKGROUND_VOLUME 100
      END
      IF ($BACKGROUND_VOLUME == "100"):
        RUN _CONFIG -write _TERM_BACKGROUND_VOLUME 0
      END
    END
    IF ($CURSOR_Y == 40-$YOFF):
      # Switch retro profile
      $RETROPROFILE_IDX = $RETROPROFILE_IDX + 1
      IF ($RETROPROFILE_IDX > 3):
        $RETROPROFILE_IDX = 0
      END
      IF ($RETROPROFILE_IDX == 0):
        RUN _CONFIG -write _RETROPROFILE c64
      END
      IF ($RETROPROFILE_IDX == 1):
        RUN _CONFIG -write _RETROPROFILE ibm5150
      END
      IF ($RETROPROFILE_IDX == 2):
        RUN _CONFIG -write _RETROPROFILE vt220-amber
      END
      IF ($RETROPROFILE_IDX == 3):
        RUN _CONFIG -write _RETROPROFILE vt220-green
      END
    END
    IF ($CURSOR_Y == 42-$YOFF):
      # Set shader passes
      IF ($SHADER == "enable"):
        RUN _CONFIG -write _TERM_SHADER disable
      END
      IF ($SHADER == "disable"):
        RUN _CONFIG -write _TERM_SHADER enable
      END
    END
    IF ($CURSOR_Y == 44-$YOFF):
      # Switch shaders quality
      $SHADER_QUALITY_IDX = $SHADER_QUALITY_IDX + 1
      IF ($SHADER_QUALITY_IDX > 2):
        $SHADER_QUALITY_IDX = 0
      END
      IF ($SHADER_QUALITY_IDX == 0):
        RUN _CONFIG -write SHADER_QUALITY LOW
      END
      IF ($SHADER_QUALITY_IDX == 1):
        RUN _CONFIG -write SHADER_QUALITY MEDIUM
      END
      IF ($SHADER_QUALITY_IDX == 2):
        RUN _CONFIG -write SHADER_QUALITY HIGH
      END
    END
    IF ($CURSOR_Y == 46-$YOFF):
      # Switch overlay on/off
      IF ($OVERLAY == "enable"):
        RUN _CONFIG -write _TERM_OVERLAY disable
      END
      IF ($OVERLAY == "disable"):
        RUN _CONFIG -write _TERM_OVERLAY enable
      END
    END
    IF ($CURSOR_Y == 48-$YOFF):
      $MENU = "QUICK START"
    END

  END

END


GOTO LAUNCHER_MENU

#-------------------------------------------------------------------------
# EXIT

@EXIT

RUN _CLEAR

# Apply config.ini

RUN _CONFIG -read _TERM_RESOLUTION TO $RESOLUTION
RUN _TERM_RESOLUTION $RESOLUTION

RUN _CONFIG -read _TERM_MOUSE_SHOW TO $MOUSE
RUN _TERM_MOUSE_SHOW $MOUSE

RUN _CONFIG -read _RETROPROFILE TO $RETROPROFILE
RUN _RETROPROFILE apply $RETROPROFILE

RUN _CONFIG -read _TERM_TYPING_SOUND TO $TYPING_SOUND
RUN _TERM_TYPING_SOUND $TYPING_SOUND
RUN _CONFIG -read _TERM_TYPING_VOLUME TO $TYPING_VOLUME
RUN _TERM_TYPING_VOLUME $TYPING_VOLUME
RUN _CONFIG -read _TERM_BACKGROUND_SOUND TO $BACKGROUND_SOUND
RUN _TERM_BACKGROUND_SOUND $BACKGROUND_SOUND
RUN _CONFIG -read _TERM_BACKGROUND_VOLUME TO $BACKGROUND_VOLUME
RUN _TERM_BACKGROUND_VOLUME $BACKGROUND_VOLUME

RUN _CONFIG -read _TERM_SHADER TO $SHADER
RUN _TERM_SHADER $SHADER

RUN _CONFIG -read _TERM_OVERLAY TO $OVERLAY
RUN _CONFIG -read _TERM_LAYOUT_ASPECT TO $LAYOUT_ASPECT
RUN _TERM_LAYOUT_ASPECT $LAYOUT_ASPECT
RUN _CONFIG -read _TERM_OVERLAY_ZOOM TO $OVERLAY_ZOOM
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_X TO $OVERLAY_IMAGE_OFFSET_X
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_Y TO $OVERLAY_IMAGE_OFFSET_Y
RUN _TERM_OVERLAY_ZOOM $OVERLAY_ZOOM
RUN _TERM_OVERLAY_OFFSET $OVERLAY_IMAGE_OFFSET_X $OVERLAY_IMAGE_OFFSET_Y
IF ($OVERLAY == "enable"):
  RUN _TERM_OVERLAY enable
  RUN _TERM_SIZE $TERMINAL_WIDTH $TERMINAL_HEIGHT
  RUN _TERM_OFFSET $TERMINAL_OFFSET_X $TERMINAL_OFFSET_Y
END
IF ($OVERLAY == "disable"):
  RUN _TERM_OVERLAY disable
  RUN _TERM_SIZE 0 0
  RUN _TERM_OFFSET 0 0
END


# Return cursor blink
RUN _TERM_CURSOR_BLINK enable

PRINT "\n"

