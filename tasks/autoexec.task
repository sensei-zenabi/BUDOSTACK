
# autoexec.task
#=========================================================================
# This TASK is being ran when BUDOSTACK starts.
# If you want to release your own application or game, modify the marked
# section below according to instructions.
#=========================================================================

#-------------------------------------------------------------------------
# INITIALIZATION

# Required to clear all screen buffer
RUN cls

# If ./apps/terminal is not running, skip the whole autoexec.task
SET $TMP = 0
RUN _TERM_ACTIVE TO $TMP
IF ($TMP==0):
  GOTO EXIT
END

# Disable mouse for the UI
RUN _TERM_MOUSE_SHOW disable

# Initialize variables

SET $MARGIN = 0
SET $TYPING_SOUND = "disable"
SET $BACKGROUND_SOUND = "enable"
SET $BACKGROUND_VOLUME = 25
SET $SHADER = "disable"
SET $SHADER_QUALITY = "MEDIUM"
SET $OVERLAY = "null"
SET $LAYOUT_ASPECT = "screen"
SET $OVERLAY_ZOOM = 100
SET $OVERLAY_IMAGE_OFFSET_X = 0
SET $OVERLAY_IMAGE_OFFSET_Y = 0
SET $TERMINAL_WIDTH = 0
SET $TERMINAL_HEIGHT = 0
SET $TERMINAL_OFFSET_X = 0
SET $TERMINAL_OFFSET_Y = 0
SET $RESOLUTION = "null"
SET $TERM_SIZE = "81.5104167 74.0740741"
SET $MOUSE = "null"
SET $RETROPROFILE = "vt220-green"

# Run configurations from config.ini

RUN _CONFIG -read _RETROPROFILE TO $RETROPROFILE
RUN _RETROPROFILE apply $RETROPROFILE
RUN _CONFIG -read _TERM_MARGIN TO $MARGIN
RUN _TERM_MARGIN $MARGIN
RUN _CONFIG -read _TERM_TYPING_SOUND TO $TYPING_SOUND
RUN _TERM_TYPING_SOUND $TYPING_SOUND
RUN _CONFIG -read _TERM_TYPING_VOLUME TO $TYPING_VOLUME
RUN _TERM_TYPING_VOLUME $TYPING_VOLUME
RUN _CONFIG -read _TERM_BACKGROUND_SOUND TO $BACKGROUND_SOUND
RUN _TERM_BACKGROUND_SOUND $BACKGROUND_SOUND
RUN _CONFIG -read _TERM_BACKGROUND_VOLUME TO $BACKGROUND_VOLUME
RUN _TERM_BACKGROUND_VOLUME $BACKGROUND_VOLUME
RUN _CONFIG -read _TERM_SHADER TO $SHADER
RUN _TERM_SHADER $SHADER
RUN _CONFIG -read _TERM_OVERLAY TO $OVERLAY
RUN _CONFIG -read _TERM_LAYOUT_ASPECT TO $LAYOUT_ASPECT
RUN _TERM_LAYOUT_ASPECT $LAYOUT_ASPECT
RUN _CONFIG -read _TERM_OVERLAY_ZOOM TO $OVERLAY_ZOOM
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_X TO $OVERLAY_IMAGE_OFFSET_X
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_Y TO $OVERLAY_IMAGE_OFFSET_Y
RUN _TERM_OVERLAY_ZOOM $OVERLAY_ZOOM
RUN _TERM_OVERLAY_OFFSET $OVERLAY_IMAGE_OFFSET_X $OVERLAY_IMAGE_OFFSET_Y
RUN _CONFIG -read TERMINAL_WIDTH TO $TERMINAL_WIDTH
RUN _CONFIG -read TERMINAL_HEIGHT TO $TERMINAL_HEIGHT
RUN _CONFIG -read TERMINAL_OFFSET_X TO $TERMINAL_OFFSET_X
RUN _CONFIG -read TERMINAL_OFFSET_Y TO $TERMINAL_OFFSET_Y
IF ($OVERLAY == "enable"):
  RUN _TERM_OVERLAY enable
  RUN _TERM_SIZE $TERMINAL_WIDTH $TERMINAL_HEIGHT
  RUN _TERM_OFFSET $TERMINAL_OFFSET_X $TERMINAL_OFFSET_Y
END
IF ($OVERLAY == "disable"):
  RUN _TERM_OVERLAY disable
  RUN _TERM_SIZE 0 0
  RUN _TERM_OFFSET 0 0
END


# Run or set other default configurations

RUN _TERM_RESOLUTION HIGH


#-------------------------------------------------------------------------
# BUDOSTACK LOADER
# Simulated 1993 486DX2-66 boot (8 MB RAM, floppy boot); hardware figures are period scenery.
# ROM/POST runs silently. Disk sounds belong only to seeks and disk reads.
# The floppy sample is 1411 ms long: leave >= 1450 ms before reusing channel 1.
# Channel 2 is reserved for the short POST beep, not a second disk drive.

SET $SELECTION = "y"
RUN cls
RUN _TERM_TYPING_SOUND disable
RUN _WAIT 500
PRINT "BUDOSTACK 486 BIOS  Version 2.00\n"
PRINT "Copyright (C) 1993 BUDOSTACK Corporation\n\n"
PRINT "80486DX2 CPU at 66 MHz\n"
RUN _WAIT 350
PRINT "ROM BIOS Checksum .... OK\n"
RUN _WAIT 250
PRINT "CMOS Battery ......... OK\n"
RUN _WAIT 250
PRINT "Internal Cache ....... 8 KB Enabled\n\n"
RUN _WAIT 250

# Count conventional memory in place, as a BIOS would; no disk activity.
FOR ($BOOT_RAM=64; $BOOT_RAM<=640; $BOOT_RAM=$BOOT_RAM+64):
  PRINT "\rBase Memory:     "
  IF ($BOOT_RAM < 100):
    PRINT " "
  END
  PRINT $BOOT_RAM + " KB OK"
  RUN _WAIT 100
END
PRINT "\n"
# 8 MB installed: 640 KB base + 384 KB reserved + 7168 KB extended.
FOR ($BOOT_RAM=256; $BOOT_RAM<=7168; $BOOT_RAM=$BOOT_RAM+256):
  PRINT "\rExtended Memory: "
  IF ($BOOT_RAM < 1000):
    PRINT " "
  END
  PRINT $BOOT_RAM + " KB OK"
  RUN _WAIT 40
END
PRINT "\n\n"
PRINT "Keyboard ............. OK\n"
RUN _WAIT 250
PRINT "Video Adapter ........ VGA\n"
RUN _WAIT 250
PRINT "Diskette Drive A: ..... 1.44 MB\n"

# POST recalibrates the floppy head before handing control to the boot loader.
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
RUN _WAIT 1500
PRINT "Diskette Controller .. OK\n"
RUN _WAIT 250
RUN _TERM_SOUND_PLAY 2 ../sounds/environment/computer_beep.wav 100
RUN _WAIT 300
PRINT "\nBooting from drive A:\n"
RUN _WAIT 350

# Boot sector and BUDOSTACK core: separate disk read bursts.
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
RUN _WAIT 1600
PRINT "\nBUDOSTACK SYSTEM LOADER\n"
PRINT "Copyright (C) 1993 BUDOSTACK Corporation\n\n"
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
PRINT "Loading BUDOSTACK core..."
RUN _WAIT 1700
PRINT " OK\n"
RUN _WAIT 200

# Load system services before bringing up the terminal.
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
PRINT "Loading system services...\n"
RUN _WAIT 1500
PRINT "Memory manager ....... READY\n"
PRINT "Device interface ..... READY\n"
PRINT "Console driver ....... READY\n"
RUN _WAIT 200
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
PRINT "Loading BUDOSTACK terminal..."
RUN _WAIT 1500
PRINT " OK\n\n"
RUN _WAIT 350

# Read startup settings and prepare the BUDOSTACK session.
RUN _TERM_SOUND_PLAY 1 ../sounds/628246__asiekierka__floppy_access6.ogg 100
PRINT "Reading startup configuration..."
RUN _WAIT 1500
PRINT " OK\n"
PRINT "Command library ...... READY\n"
PRINT "Primary terminal ..... ACTIVE\n\n"
PRINT "BUDOSTACK ready.\n\n"
RUN _WAIT 300

# Keep the complete POST visible in the 80x60 HIGH terminal.
RUN _TERM_TYPING_SOUND $TYPING_SOUND
PRINT ">> Start BUDOWIN? [y/n]: "
INPUT $SELECTION

IF ($SELECTION != "y"):
  IF ($SELECTION != "Y"):
    GOTO EXIT
  END
END

# Start the native GUI at VGA HIGH resolution and return to the command line.
RUN _TERM_RESOLUTION HIGH
RUN _TERM_TYPING_SOUND disable
RUN budo/budowin
GOTO EXIT

#-------------------------------------------------------------------------
# EXIT

@EXIT

RUN _CLEAR

# Apply config.ini

RUN _CONFIG -read _TERM_RESOLUTION TO $RESOLUTION
RUN _TERM_RESOLUTION $RESOLUTION

RUN _CONFIG -read _TERM_MOUSE_SHOW TO $MOUSE
RUN _TERM_MOUSE_SHOW $MOUSE

RUN _CONFIG -read _RETROPROFILE TO $RETROPROFILE
RUN _RETROPROFILE apply $RETROPROFILE

RUN _CONFIG -read _TERM_TYPING_SOUND TO $TYPING_SOUND
RUN _TERM_TYPING_SOUND $TYPING_SOUND
RUN _CONFIG -read _TERM_TYPING_VOLUME TO $TYPING_VOLUME
RUN _TERM_TYPING_VOLUME $TYPING_VOLUME
RUN _CONFIG -read _TERM_BACKGROUND_SOUND TO $BACKGROUND_SOUND
RUN _TERM_BACKGROUND_SOUND $BACKGROUND_SOUND
RUN _CONFIG -read _TERM_BACKGROUND_VOLUME TO $BACKGROUND_VOLUME
RUN _TERM_BACKGROUND_VOLUME $BACKGROUND_VOLUME

RUN _CONFIG -read _TERM_SHADER TO $SHADER
RUN _TERM_SHADER $SHADER

RUN _CONFIG -read _TERM_OVERLAY TO $OVERLAY
RUN _CONFIG -read _TERM_LAYOUT_ASPECT TO $LAYOUT_ASPECT
RUN _TERM_LAYOUT_ASPECT $LAYOUT_ASPECT
RUN _CONFIG -read _TERM_OVERLAY_ZOOM TO $OVERLAY_ZOOM
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_X TO $OVERLAY_IMAGE_OFFSET_X
RUN _CONFIG -read _TERM_OVERLAY_OFFSET_Y TO $OVERLAY_IMAGE_OFFSET_Y
RUN _TERM_OVERLAY_ZOOM $OVERLAY_ZOOM
RUN _TERM_OVERLAY_OFFSET $OVERLAY_IMAGE_OFFSET_X $OVERLAY_IMAGE_OFFSET_Y
IF ($OVERLAY == "enable"):
  RUN _TERM_OVERLAY enable
  RUN _TERM_SIZE $TERMINAL_WIDTH $TERMINAL_HEIGHT
  RUN _TERM_OFFSET $TERMINAL_OFFSET_X $TERMINAL_OFFSET_Y
END
IF ($OVERLAY == "disable"):
  RUN _TERM_OVERLAY disable
  RUN _TERM_SIZE 0 0
  RUN _TERM_OFFSET 0 0
END


# Return cursor blink
RUN _TERM_CURSOR_BLINK enable

PRINT "\n"
